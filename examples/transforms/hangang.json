    {
      "id": "lua-json",
      "path_prefix": "/lua-json",
      "path_match": "exact",
      "backends": [
        "http://127.0.0.1:18081"
      ],
      "max_requests": 16,
      "request_transform": {
        "mode": "buffered",
        "lua": "-- Buffered request: preserve JSON types, remove a client-controlled identity,\n-- and add a field. Native headers are configured alongside this script.\nlocal document = hangang.json_decode(hangang.body())\ndocument.client_role = nil\ndocument.source = \"hangang\"\ndocument.tags = document.tags or hangang.array()\nreturn hangang.json_encode(document)\n",
        "max_buffer_bytes": 16384,
        "max_output_bytes": 16384,
        "timeout_ms": 5000
      },
      "response_transform": {
        "mode": "buffered",
        "lua": "-- Runs in a fresh isolated VM for this response or NDJSON record.\nlocal document = hangang.json_decode(hangang.body())\ndocument.secret = nil\ndocument.processed = true\ndocument.optional = hangang.null\nhangang.set_body(hangang.json_encode(document))\n",
        "max_buffer_bytes": 16384,
        "max_output_bytes": 16384,
        "timeout_ms": 5000
      },
      "lua": "-- Existing routing policy API, independent of request/response body scripts.\n-- A returned backend must be listed in this route's configured backends.\nif hangang.header(\"x-deny\") == \"yes\" then\n    hangang.reject(403)\nend\nhangang.set_header(\"x-policy\", \"checked\")\n"
    },
    {
      "id": "native-lines",
