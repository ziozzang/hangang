      ],
      "max_requests": 16,
      "response_transform": {
        "mode": "sse",
        "lua": "-- The gateway preserves event/id/retry/comments and joins the data fields.\n-- Handle a common application sentinel before trying to decode JSON.\nif hangang.body() == \"[DONE]\" then\n    return \"[DONE]\"\nend\nlocal event = hangang.json_decode(hangang.body())\nevent.secret = nil\nevent.gateway = true\nreturn hangang.json_encode(event)\n",
        "max_buffer_bytes": 16384,
