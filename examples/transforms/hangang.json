    {
      "id": "lua-lines",
      "path_prefix": "/lua-lines",
      "path_match": "exact",
      "backends": [
        "http://127.0.0.1:18081"
      ],
      "max_requests": 16,
      "response_transform": {
        "mode": "lines",
        "lua": "-- A complete bounded line arrives here, even if its bytes crossed HTTP chunks.\n-- Lua patterns operate on bytes. Keep the output within max_output_bytes.\nlocal line = string.gsub(hangang.body(), \"token=[^%s]+\", \"token=[redacted]\")\nreturn line\n",
        "max_buffer_bytes": 16384,
        "max_output_bytes": 16384,
        "timeout_ms": 5000
      }
    },
