{
  "http": [
    {
      "id": "pinned-http",
      "host": "public.example",
      "backends": ["https://foo.bar"],
      "upstream_host": "foo.bar",
      "upstream": {
        "connect_address": "192.0.2.4:443",
        "tls": {"server_name": "foo.bar", "insecure_skip_verify": true, "max_fragment_size": 128}
      }
    },
    {
      "id": "dns-and-socks",
      "path_prefix": "/via-proxy/",
      "backends": ["https://origin.example"],
      "upstream": {
        "dns_servers": ["192.0.2.53:53"],
        "socks5": {"address": "127.0.0.1:1080"}
      }
    }
  ],
  "tcp": [
    {
      "id": "tls-client-tunnel",
      "listen": "127.0.0.1:9444",
      "backends": ["foo.bar:443"],
      "upstream": {
        "connect_address": "192.0.2.4:443",
        "tls": {"server_name": "foo.bar"}
      }
    }
  ]
}
