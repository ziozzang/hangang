# Copy to deploy/.env, then adjust paths and ports for this host.
# Put HANGANG_ADMIN_TOKEN only in the separate private admin.env file.
HANGANG_IMAGE=hangang:local
HANGANG_UID=65532
HANGANG_GID=65532
HANGANG_STATE_DIR=./state
HANGANG_ADMIN_ENV_FILE=./admin.env
HANGANG_PUBLIC_BIND_IP=127.0.0.1
HANGANG_PUBLIC_PORT=8080
HANGANG_ADMIN_PORT=49000
